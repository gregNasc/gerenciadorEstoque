SECRET_KEY=troque-esta-chave
# Desenvolvimento local. Em homologação e produção, use False.
DEBUG=True
DJANGO_ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
APP_BASE_URL=http://localhost:8000
# No Render, as tres configuracoes acima usam automaticamente
# RENDER_EXTERNAL_HOSTNAME e RENDER_EXTERNAL_URL quando nao forem informadas.
# Para dominio personalizado, informe o host/origem explicitamente.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
DATABASE_HEALTH_CHECKS=True
DATABASE_SSL_REQUIRED=False
POSTGRES_DB=estoque_render_dump
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admininventory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chat em tempo real. Em desenvolvimento, deixe vazio para usar memória local.
# Em produção, informe Redis, por exemplo: redis://redis:6379/0
CHANNEL_REDIS_URL=

# Uploads maiores que 1 MB são processados em disco temporário. No Render,
# mantenha /tmp; o armazenamento definitivo continua sendo o storage privado.
FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
FILE_UPLOAD_TEMP_DIR=/tmp

# Somente para scripts legados executados manualmente.
LEGACY_DATABASE_URL=
LEGACY_POSTGRES_DB=estoque
LEGACY_POSTGRES_USER=postgres
LEGACY_POSTGRES_PASSWORD=
LEGACY_POSTGRES_HOST=localhost
LEGACY_POSTGRES_PORT=5432

# Uploads persistentes (obrigatório em produção).
# Opção A — volume persistente: monte um disco (Render: /var/data) e defina
# PERSISTENT_STORAGE_ROOT=/var/data. As pastas media/ e private_media/ serão
# criadas separadamente dentro dele.
# Opção B — S3/compatível: use USE_S3=True e informe o bucket/credenciais.
# Não aponte estes caminhos para o diretório do código do deploy.
PERSISTENT_STORAGE_ROOT=
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# Necessárias no Render ao usar S3 sem IAM Role. Nunca versionar valores reais.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ative HSTS somente depois de validar HTTPS e domínio em homologação.
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

INVENTORY_PLANNING_API_URL=https://example.invalid/api/integration/v1
INVENTORY_PLANNING_API_KEY=
INVENTORY_PLANNING_TIMEOUT=15
INVENTORY_PLANNING_MAX_RETRIES=4
INVENTORY_PLANNING_BACKOFF_BASE=1
INVENTORY_PLANNING_CATALOG_CACHE_TTL=21600
INVENTORY_PLANNING_SYSTEM_USERNAME=inventory_planning_sync
INVENTORY_PLANNING_LOG_LEVEL=INFO

# Portal de inventários em tempo real (conta técnica, acesso somente leitura).
INVENTORY_PORTAL_ENABLED=False
INVENTORY_PORTAL_URL=https://novoportal.inventorybrasil.com.br/
INVENTORY_PORTAL_USERNAME=
INVENTORY_PORTAL_PASSWORD=
INVENTORY_PORTAL_TIMEOUT=20
INVENTORY_PORTAL_MAX_RANGE_DAYS=31
INVENTORY_PORTAL_MAX_DETAIL_RECORDS=20
INVENTORY_PORTAL_LOG_LEVEL=INFO

# Interpretação semântica opcional da Tory (Responses API + saída estruturada).
TORY_LLM_ENABLED=False
TORY_LLM_MODEL=gpt-5.6-sol
TORY_LLM_TIMEOUT=20
TORY_LLM_REASONING_EFFORT=medium
TORY_LLM_MIN_CONFIDENCE=0.78
TORY_LLM_LOG_LEVEL=INFO
OPENAI_API_KEY=

# Pesquisa manual de preços dos fornecedores utilizados pela empresa.
ONLINE_PRICE_SEARCH_TIMEOUT=15
GIMBA_PRICE_SEARCH_ENABLED=True
FIDELITY_PRICE_SEARCH_ENABLED=True
MERCADO_LIVRE_ACCESS_TOKEN=

# Entrega opcional de comunicados por WhatsApp (desabilitada por padrão).
WHATSAPP_ENABLED=False
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_BASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_TIMEOUT=10
WHATSAPP_MAX_RETRIES=5
WHATSAPP_RETRY_BASE_SECONDS=60
WHATSAPP_PROCESSING_TIMEOUT_SECONDS=900
